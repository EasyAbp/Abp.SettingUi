@using EasyAbp.Abp.SettingUi.Localization
@using Microsoft.AspNetCore.Mvc.Localization
@model IEnumerable<SettingHtmlInfo>
@inject IHtmlLocalizer<SettingUiResource> L

@foreach (var group in Model.GroupBy(sd => sd.Group2))
{
    <form method="post" id="@(group.Key)SettingGroup" class="setting-ui">
        <abp-card class="mb-3">
            <abp-card-header>
                <h4>@L[group.Key]</h4>
            </abp-card-header>
            <abp-card-body>
                @foreach (var settingHtmlInfo in group)
                {
                    // An encrypted setting is a password box whatever its type, so the page never holds the secret
                    // until the user asks to see it.
                    var partialName = settingHtmlInfo.IsEncrypted ? "Encrypted" : settingHtmlInfo.Type.ToPascalCase();
                    <div class="mb-3 setting-ui-setting" data-setting-name="@settingHtmlInfo.Name">
                        <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                            <label class="form-label mb-0" for="@settingHtmlInfo.Name">@settingHtmlInfo.DisplayName</label>
                            @await Html.PartialAsync("~/Pages/Components/SettingUi/Partials/_ValueSource.cshtml", settingHtmlInfo)
                        </div>
                        @await Html.PartialAsync($"~/Pages/Components/SettingUi/Partials/_{partialName}.cshtml", settingHtmlInfo)
                    </div>
                }
                <hr class="my-3">
                <div>
                    <abp-button type="submit" button-type="Primary" text="@L["Save"].Value" />
                    <abp-button button-type="Warning" text="@L["Reset"].Value" class="reset" />
                </div>
            </abp-card-body>
        </abp-card>
    </form>
}